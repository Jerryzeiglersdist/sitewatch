# Copy to .env and adjust. Everything has a sensible default; blank lines use it.

# What to watch
SITE_URL=https://www.zeiglersdist.com/
# Optional: a string that must appear in the page body for the check to pass.
# Leave blank to accept any HTTP 200-399 response.
CHECK_TEXT=
# Optional second site (e.g. the Aldrich beta). Blank to disable.
BETA_URL=https://zeiglersdist.sites.aes2.com/
# split: top half = main site (green trace / red flash), bottom half = beta
#        (orange trace / yellow flash). strip: beta as a solid bar on the bottom rows.
LAYOUT=split
# split layout: lr = live site on the left half, beta on the right; tb = live top, beta bottom
SPLIT=lr
# tetris: 1 = classic piece colours, 0 = pieces in the site's own colour
TETRIS_COLORS=1
# Split layout: what each half shows while its site is up. tetris = auto-playing
# Tetris (stack pulses on every good check); ripple = ring pulsing out from the
# centre with a white spark per good check; bars = last 8 response times as a bar
# chart (BAR_SCALE seconds fills the height); sonar = radar sweep with a blip per
# good check; ekg = heartbeat trace.
MAIN_PATTERN=tetris
BETA_PATTERN=tetris
BAR_SCALE=2.0
BETA_ROWS=2
BETA_UP_COLOR=255,70,0
BETA_DOWN_COLOR=255,190,0
# Used to tell "site is down" from "office internet is down"
REFERENCE_URL=https://www.google.com/

# Timing
CHECK_INTERVAL=30
FAIL_THRESHOLD=3
# Reference-site (Google) failures in a row before the panel goes purple
NET_GRACE=2
HTTP_TIMEOUT=10

# Optional: Teams/Slack-style incoming webhook. Posts {"text": "..."} on every
# state change. Leave blank for light only.
ALERT_WEBHOOK_URL=

# Logs older than this many days are deleted
LOG_RETENTION_DAYS=15

# LED panel
LED_PIN=18
LED_COUNT=64
# Global cap 0-255. 64 (~25%) keeps the panel within what the Pi's 5V pin can supply.
LED_BRIGHTNESS=64
# How bright the idle green is, 0-255 (kept low so it's a glow, not a lamp)
GREEN_LEVEL=40
RED_LEVEL=255
# Whole-panel pulse colour when the office internet is out
NET_COLOR=150,0,255
# Seconds on / seconds off for the red flash
FLASH_PERIOD=0.4
# Idle animation while the site is up: ekg | heartbeat | snake | breathe | twinkle | solid
GREEN_PATTERN=ekg
# Grid layout for the ekg pattern. Rotate 0/90/180/270 if the trace runs the wrong way.
PANEL_WIDTH=8
PANEL_ROTATE=0
PANEL_SERPENTINE=1
